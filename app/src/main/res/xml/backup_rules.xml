<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules. See https://developer.android.com/guide/topics/data/autobackup
   Note: this file is ignored on devices older than API 31, which use
   data_extraction_rules.xml instead.
-->
<full-backup-content>
    <!-- The encrypted Anthropic API key: the keystore key that decrypts it
         never leaves this phone, so a restored copy would be unreadable
         anyway — and a secret has no business in a cloud backup. -->
    <exclude domain="sharedpref" path="ask_key.xml"/>
</full-backup-content>
